          <div><label for="end">End</label><input id="end" name="end" type="time" required></div>
        </div>
        <button class="primary" type="submit">Add class</button>
        <button class="ghost" type="button" id="demo">Add a class that starts in 1 minute</button>
      </form>
    </section>
  </div>
</div>

<div id="toast" role="status"></div>
<div class="id-box">ARPEET PATEL, PRN: 24070521218</div>

<!-- ===== ES6 MODULE 1: timeUtils (export) ===== -->
<script type="text/plain" id="mod-timeUtils">
export const pad = (n) => String(n).padStart(2, "0");

// "09:30" -> Date object for today (dayOffset shifts the day)
export function toDate(hhmm, dayOffset = 0) {
  const [h, m] = hhmm.split(":").map(Number);
  const d = new Date();
  d.setDate(d.getDate() + dayOffset);
  d.setHours(h, m, 0, 0);
  return d;
}

// milliseconds -> "HH:MM:SS"
export function formatCountdown(ms) {
  const total = Math.max(0, Math.floor(ms / 1000));
  return `${pad(Math.floor(total / 3600))}:${pad(Math.floor((total % 3600) / 60))}:${pad(total % 60)}`;
}

// "14:05" -> "2:05 PM"
export function to12h(hhmm) {
  const [h, m] = hhmm.split(":").map(Number);
  return `${h % 12 || 12}:${pad(m)} ${h >= 12 ? "PM" : "AM"}`;
}

export const nowHHMM = (offsetMin = 0) => {
  const d = new Date(Date.now() + offsetMin * 60000);
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
};

export default { pad, toDate, formatCountdown, to12h, nowHHMM };
</script>

<!-- ===== ES6 MODULE 2: scheduler (imports timeUtils, exports Scheduler) ===== -->
<script type="text/plain" id="mod-scheduler">
import { toDate } from "./timeUtils.js";

export const defaultClasses = [
  { id: 1, subject: "Mathematics",          room: "Room 204", start: "09:00", end: "09:50" },
  { id: 2, subject: "Data Structures",      room: "Lab 3",    start: "10:00", end: "10:50" },
  { id: 3, subject: "Physics",              room: "Room 110", start: "11:15", end: "12:05" },
  { id: 4, subject: "Web Technologies",     room: "Lab 1",    start: "13:00", end: "14:30" },
  { id: 5, subject: "Communication Skills", room: "Room 301", start: "15:00", end: "15:50" },
];

export default class Scheduler {
  constructor(classes = []) {
    this.classes = [...classes];
    this.nextId = classes.length + 1;
    this.timeouts = [];
  }

  add({ subject, room, start, end }) {
    this.classes.push({ id: this.nextId++, subject, room, start, end });
    this.classes.sort((a, b) => a.start.localeCompare(b.start));
  }

  remove(id) {
    this.classes = this.classes.filter((c) => c.id !== id);
  }

  // "live" | "upcoming" | "done"
  statusOf(c, now = new Date()) {
    if (now >= toDate(c.end)) return "done";
    if (now >= toDate(c.start)) return "live";
    return "upcoming";
  }

  current(now = new Date()) {
    return this.classes.find((c) => this.statusOf(c, now) === "live") || null;
  }

  // Next class today, otherwise the first class tomorrow
  next(now = new Date()) {
    const today = this.classes.find((c) => toDate(c.start) > now);
    if (today) return { cls: today, at: toDate(today.start), tomorrow: false };
    if (!this.classes.length) return null;
    const first = this.classes[0];
    return { cls: first, at: toDate(first.start, 1), tomorrow: true };
  }

  // setTimeout: fire a callback exactly when each class starts / ends
  scheduleAlerts(callback) {
    this.timeouts.forEach(clearTimeout);
    this.timeouts = [];
    const now = Date.now();
    for (const c of this.classes) {
      for (const type of ["start", "end"]) {
        const delay = toDate(c[type]).getTime() - now;
        if (delay > 0) this.timeouts.push(setTimeout(() => callback(c, type), delay));
      }
    }
  }
}
</script>

<!-- ===== ES6 MODULE 3: main (imports scheduler + timeUtils) ===== -->
<script type="text/plain" id="mod-main">
import Scheduler, { defaultClasses } from "./scheduler.js";
import { formatCountdown, to12h, toDate, pad, nowHHMM } from "./timeUtils.js";

const $ = (id) => document.getElementById(id);
const scheduler = new Scheduler(defaultClasses);

/* ---------- Rendering ---------- */
function renderList() {
  const now = new Date();
  $("list").innerHTML = scheduler.classes.map((c) => {
    const s = scheduler.statusOf(c, now);
    const label = { live: "In progress", upcoming: "Upcoming", done: "Completed" }[s];
    return `<li class="item ${s}">
      <div class="time">${to12h(c.start)}<span>${to12h(c.end)}</span></div>
      <div class="info"><strong>${c.subject}</strong><small>${c.room}</small></div>
      <span class="badge ${s}">${label}</span>
      <button class="del" data-id="${c.id}" aria-label="Remove ${c.subject}">&times;</button>
    </li>`;
  }).join("") || `<li class="empty">No classes yet. Add one using the form.</li>`;
}

function renderHero() {
  const now = new Date();
  const cur = scheduler.current(now);
  const nxt = scheduler.next(now);
  const bar = $("bar");

  if (cur) {
    const start = toDate(cur.start), end = toDate(cur.end);
    $("heroLabel").textContent = "Class in progress";
    $("heroTitle").textContent = cur.subject;
    $("heroSub").textContent = `${cur.room} · ends at ${to12h(cur.end)}`;
    $("countdown").textContent = formatCountdown(end - now);
    $("cdCaption").textContent = "remaining";
    bar.style.width = `${Math.min(100, ((now - start) / (end - start)) * 100)}%`;
  } else if (nxt) {
    $("heroLabel").textContent = nxt.tomorrow ? "First class tomorrow" : "Next class";
    $("heroTitle").textContent = nxt.cls.subject;
    $("heroSub").textContent = `${nxt.cls.room} · starts at ${to12h(nxt.cls.start)}`;
    $("countdown").textContent = formatCountdown(nxt.at - now);
    $("cdCaption").textContent = "until start";
    bar.style.width = "0%";
  } else {
    $("heroLabel").textContent = "Free day";
    $("heroTitle").textContent = "Nothing scheduled";
    $("heroSub").textContent = "Add a class to begin.";
    $("countdown").textContent = "--:--:--";
    $("cdCaption").textContent = "";
    bar.style.width = "0%";
  }
}

function tick() {
  const now = new Date();
  $("clock").textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
  $("date").textContent = now.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
  renderHero();
  if (now.getSeconds() === 0) renderList(); // refresh statuses every minute
}

/* ---------- Toast (setTimeout auto-hide) ---------- */
let toastTimer;
function toast(msg) {
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 5000);
}

/* ---------- Alerts (setTimeout scheduled per class) ---------- */
function armAlerts() {
  scheduler.scheduleAlerts((c, type) => {
    toast(type === "start" ? `${c.subject} has started in ${c.room}.` : `${c.subject} has ended.`);
    renderList();
    renderHero();
  });
}

function refresh() { renderList(); renderHero(); armAlerts(); }

/* ---------- Events ---------- */
$("form").addEventListener("submit", (e) => {
  e.preventDefault();
  const f = new FormData(e.target);
  const [subject, room, start, end] = ["subject", "room", "start", "end"].map((k) => f.get(k).trim());
  if (end <= start) return toast("End time must be after the start time.");
  scheduler.add({ subject, room: room || "TBA", start, end });
  e.target.reset();
  refresh();
  toast(`${subject} added to your schedule.`);
});

$("list").addEventListener("click", (e) => {
  const btn = e.target.closest(".del");
  if (!btn) return;
  scheduler.remove(Number(btn.dataset.id));
  refresh();
});

$("demo").addEventListener("click", () => {
  scheduler.add({ subject: "Demo Session", room: "Room 1", start: nowHHMM(1), end: nowHHMM(3) });
  refresh();
  toast("Demo class added. It starts in about a minute.");
});

/* ---------- Start: setInterval drives the live clock & countdown ---------- */
refresh();
tick();
setInterval(tick, 1000);
</script>

<!-- Loader: turns each module block into a real ES module so import/export work in ONE file -->
<script>
(async () => {
  const src = (id) => document.getElementById(id).textContent;
  const blob = (code) => URL.createObjectURL(new Blob([code], { type: "text/javascript" }));

  const utilsURL = blob(src("mod-timeUtils"));
  const schedulerURL = blob(src("mod-scheduler").replace('"./timeUtils.js"', `"${utilsURL}"`));
  const mainCode = src("mod-main")
    .replace('"./scheduler.js"', `"${schedulerURL}"`)
    .replace('"./timeUtils.js"', `"${utilsURL}"`);
  await import(blob(mainCode));
})();
</script>
</body>
