<style>
:root{
  --bg:#FAFAF8; --pearl:#FFFFFF; --mist:#F2F3F1; --line:#E4E6E2;
  --ink:#2A2F35; --muted:#7A828A; --accent:#5E7C78; --accent-soft:#E6EEEC; --gold:#B39B6B;
}
*{box-sizing:border-box;margin:0}
body{font-family:'Jost',system-ui,sans-serif;background:
  radial-gradient(1000px 500px at 85% -10%,#EEF1EF 0%,transparent 60%),
  radial-gradient(800px 400px at -10% 110%,#F4F1EA 0%,transparent 55%),var(--bg);
  color:var(--ink);min-height:100vh;padding:48px 24px 110px;line-height:1.5}
.wrap{max-width:1040px;margin:0 auto}
header{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:36px}
h1{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(2rem,4.5vw,3rem);letter-spacing:.01em}
header p{color:var(--muted);font-weight:300}
.now{text-align:right}
#clock{font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:500;font-variant-numeric:tabular-nums}
#date{color:var(--muted);font-size:.9rem}

.hero{background:var(--pearl);border:1px solid var(--line);border-radius:20px;padding:40px;
  display:grid;grid-template-columns:1.1fr 1fr;gap:32px;align-items:center;
  box-shadow:0 20px 50px -30px rgba(60,70,80,.25)}
#heroLabel{color:var(--accent);font-size:.95rem;letter-spacing:.06em}
#heroTitle{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(2rem,4vw,2.9rem);line-height:1.1;margin:8px 0}
#heroSub{color:var(--muted)}
.cd{text-align:center;padding:28px 16px;background:var(--mist);border-radius:14px}
#countdown{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(2.6rem,6vw,4.2rem);font-variant-numeric:tabular-nums;letter-spacing:.02em}
#cdCaption{color:var(--muted);font-size:.9rem;min-height:1.4em}
.track{height:4px;background:var(--line);border-radius:4px;margin-top:16px;overflow:hidden}
#bar{height:100%;width:0;background:var(--gold);transition:width 1s linear}

.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:28px;margin-top:28px}
.panel{background:var(--pearl);border:1px solid var(--line);border-radius:20px;padding:28px}
h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:1.6rem;margin-bottom:16px}
ul{list-style:none;padding:0}
.item{display:grid;grid-template-columns:96px 1fr auto 28px;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}
.item:last-child{border:0}
.time{font-weight:500;font-size:.95rem}.time span{display:block;color:var(--muted);font-weight:300;font-size:.82rem}
.info strong{font-weight:500;display:block}.info small{color:var(--muted)}
.badge{font-size:.78rem;padding:4px 12px;border-radius:99px;background:var(--mist);color:var(--muted)}
.badge.live{background:var(--accent-soft);color:var(--accent);font-weight:500}
.item.done .info,.item.done .time{opacity:.5}
.del{border:0;background:none;color:var(--muted);font-size:1.3rem;cursor:pointer;border-radius:50%;width:28px;height:28px}
.del:hover{background:var(--mist);color:var(--ink)}
.empty{color:var(--muted);padding:12px 0}

label{display:block;font-size:.85rem;color:var(--muted);margin:12px 0 4px}
input{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button.primary,button.ghost{font:inherit;cursor:pointer;border-radius:10px;padding:11px 16px;width:100%;margin-top:18px}
button.primary{background:var(--ink);color:#fff;border:1px solid var(--ink)}
button.primary:hover{background:#3b4249}
button.ghost{background:transparent;border:1px solid var(--line);color:var(--ink);margin-top:10px}
button.ghost:hover{background:var(--mist)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

#toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,20px);opacity:0;pointer-events:none;
  background:var(--ink);color:#fff;padding:12px 22px;border-radius:12px;transition:.35s;max-width:90vw;z-index:5}
#toast.show{opacity:1;transform:translate(-50%,0)}

.id-box{position:fixed;right:20px;bottom:20px;background:var(--pearl);border:1px solid var(--gold);
  border-radius:10px;padding:10px 16px;font-size:.85rem;font-weight:500;letter-spacing:.04em;
  box-shadow:0 8px 24px -12px rgba(60,70,80,.35);z-index:4}

@media(max-width:820px){.hero,.grid{grid-template-columns:1fr}.hero{padding:26px}.now{text-align:left}
  .item{grid-template-columns:80px 1fr 28px}.badge{display:none}
  #toast{bottom:80px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Class Scheduler</h1>
      <p>Your day at a glance, counted down to the second.</p>
    </div>
    <div class="now"><div id="clock">00:00:00</div><div id="date"></div></div>
  </header>

  <section class="hero" aria-live="polite">
    <div>
      <div id="heroLabel"></div>
      <div id="heroTitle"></div>
      <div id="heroSub"></div>
    </div>
    <div class="cd">
      <div id="countdown">--:--:--</div>
      <div id="cdCaption"></div>
      <div class="track"><div id="bar"></div></div>
    </div>
  </section>

  <div class="grid">
    <section class="panel">
      <h2>Today's timetable</h2>
      <ul id="list"></ul>
