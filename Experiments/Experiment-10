<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Classic Cars | JSON Table</title>
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<style>
		:root {
			--ivory: #fbf8ef;
			--white: #ffffff;
			--ink: #332e29;
			--muted: #81766a;
			--brown: #795d48;
			--line: #e5dbcc;
			--cream: #f4ecdf;
		}
		* { box-sizing: border-box; }
		body {
			margin: 0;
			min-height: 100vh;
			color: var(--ink);
			background: radial-gradient(circle at 10% 0%, #fff 0, transparent 35%), var(--ivory);
			font-family: Georgia, "Times New Roman", serif;
		}
		.page { width: min(1080px, calc(100% - 32px)); margin: auto; padding: 42px 0 100px; }
		header { display: flex; justify-content: space-between; align-items: end; gap: 28px; padding-bottom: 25px; border-bottom: 3px double var(--brown); }
		.eyebrow { margin: 0 0 9px; color: var(--brown); font: 700 12px Arial, sans-serif; letter-spacing: 3px; text-transform: uppercase; }
		h1 { margin: 0; font-size: clamp(46px, 8vw, 86px); line-height: .88; letter-spacing: -3px; }
		.intro { max-width: 370px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.6; }
		.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 29px 0 16px; }
		h2 { margin: 0; font-size: 24px; }
		.actions { display: flex; flex-wrap: wrap; gap: 8px; }
		button { padding: 10px 14px; border: 1px solid var(--brown); border-radius: 3px; color: #fff; background: var(--brown); cursor: pointer; font: 700 12px Arial, sans-serif; text-transform: uppercase; }
		button.secondary { color: var(--brown); background: transparent; }
		button:hover { opacity: .84; }
		.controls { display: flex; align-items: end; gap: 14px; margin-bottom: 12px; padding: 14px; border: 1px solid var(--line); background: rgba(255,255,255,.68); }
		label { display: grid; gap: 5px; color: var(--muted); font: 700 11px Arial, sans-serif; letter-spacing: 1px; text-transform: uppercase; }
		input, select { min-width: 190px; padding: 10px; border: 1px solid var(--line); border-radius: 2px; color: var(--ink); background: var(--white); font: 15px Georgia, serif; }
		.status { min-height: 25px; color: var(--muted); font: 13px Arial, sans-serif; }
		.table-wrap { overflow-x: auto; border: 1px solid var(--line); background: var(--white); box-shadow: 0 12px 30px rgba(84,65,45,.08); }
		table { width: 100%; min-width: 680px; border-collapse: collapse; }
		th { padding: 15px 18px; color: #fff; background: var(--brown); font: 700 12px Arial, sans-serif; letter-spacing: 1px; text-align: left; text-transform: uppercase; }
		td { padding: 17px 18px; border-bottom: 1px solid var(--line); font-size: 16px; }
		tbody tr:hover { background: var(--cream); }
		td:first-child { color: var(--brown); font-weight: 700; }
		.tag { padding: 5px 8px; color: #725b46; background: #f0e4d2; font: 700 11px Arial, sans-serif; text-transform: uppercase; }
		.student { position: fixed; right: 18px; bottom: 14px; padding: 10px 13px; border-top: 2px solid var(--brown); color: var(--ink); background: rgba(255,255,255,.96); box-shadow: 0 4px 15px rgba(84,65,45,.12); font: 700 12px/1.5 Arial, sans-serif; letter-spacing: 1px; text-align: right; }
		@media (max-width: 680px) {
			.page { width: calc(100% - 22px); padding-top: 25px; }
			header, .toolbar, .controls { align-items: stretch; flex-direction: column; }
			input, select { width: 100%; min-width: 0; }
		}
	</style>
</head>
<body>
	<main class="page">
		<header>
			<div><p class="eyebrow">A timeless garage collection</p><h1>Classic<br>Cars</h1></div>
			<p class="intro">Explore a carefully selected collection of memorable engines, elegant lines, and unforgettable cars.</p>
		</header>
		<section aria-labelledby="garage-title">
			<div class="toolbar">
				<h2 id="garage-title">The garage index</h2>
				<div class="actions">
					<button id="fetchButton" type="button">Load with fetch()</button>
					<button id="jqueryButton" class="secondary" type="button">Load with $.getJSON()</button>
				</div>
			</div>
			<div class="controls">
				<label>Search <input id="searchInput" type="search" placeholder="Search make or model"></label>
				<label>Sort <select id="sortSelect"><option value="year">Year</option><option value="make">Make</option><option value="model">Model</option></select></label>
				<button id="resetButton" class="secondary" type="button">Reset</button>
			</div>
			<div id="status" class="status" role="status">Loading the JSON collection...</div>
			<div class="table-wrap">
				<table>
					<thead><tr><th>Year</th><th>Model</th><th>Make</th><th>Engine</th><th>Character</th></tr></thead>
					<tbody id="carTableBody"></tbody>
				</table>
			</div>
		</section>
	</main>
	<aside class="student">ARPEET PATEL<br>PRN: 24070521218</aside>

	<script>
		const classicCars = [
			{ year: 1967, model: "Mustang Fastback", make: "Ford", engine: "4.7L V8", character: "American icon" },
			{ year: 1970, model: "E-Type", make: "Jaguar", engine: "4.2L Inline-6", character: "British elegance" },
			{ year: 1973, model: "911 Carrera RS", make: "Porsche", engine: "2.7L Flat-6", character: "Lightweight legend" },
			{ year: 1984, model: "Quattro", make: "Audi", engine: "2.1L Turbo I5", character: "Rally pioneer" },
			{ year: 1990, model: "NSX", make: "Honda", engine: "3.0L V6", character: "Aluminium pioneer" },
			{ year: 1994, model: "Impreza WRX STI", make: "Subaru", engine: "2.0L Turbo Flat-4", character: "Rally classic" }
		];
		const jsonUrl = URL.createObjectURL(new Blob([JSON.stringify(classicCars)], { type: "application/json" }));
		const tableBody = document.getElementById("carTableBody");
		const status = document.getElementById("status");
		const searchInput = document.getElementById("searchInput");
		const sortSelect = document.getElementById("sortSelect");
		let loadedCars = [];
		let loadedBy = "";

		function clearTable(message) {
			loadedCars = [];
			tableBody.innerHTML = "";
			status.textContent = message;
		}

		function renderCars(cars, method) {
			loadedCars = cars;
			loadedBy = method || loadedBy;
			const term = searchInput.value.trim().toLowerCase();
			const visibleCars = cars.filter(car => Object.values(car).some(value => String(value).toLowerCase().includes(term)))
				.sort((a, b) => String(a[sortSelect.value]).localeCompare(String(b[sortSelect.value]), undefined, { numeric: true }));
			tableBody.innerHTML = visibleCars.length ? visibleCars.map(car => `<tr><td>${car.year}</td><td><strong>${car.model}</strong></td><td>${car.make}</td><td>${car.engine}</td><td><span class="tag">${car.character}</span></td></tr>`).join("") : '<tr><td colspan="5">No matching cars found.</td></tr>';
			status.textContent = `${visibleCars.length} of ${cars.length} cars displayed using ${loadedBy}.`;
		}

		async function loadWithFetch() {
			clearTable("Loading JSON with fetch()...");
			try {
				const response = await fetch(jsonUrl);
				if (!response.ok) throw new Error("Unable to load JSON data.");
				renderCars(await response.json(), "fetch()");
			} catch (error) { status.textContent = error.message; }
		}
		function loadWithJQuery() {
			clearTable("Loading JSON with jQuery $.getJSON()...");
			$.getJSON(jsonUrl).done(cars => renderCars(cars, "jQuery $.getJSON()"))
				.fail(() => { status.textContent = "Unable to load JSON data with jQuery."; });
		}
		document.getElementById("fetchButton").addEventListener("click", loadWithFetch);
		document.getElementById("jqueryButton").addEventListener("click", loadWithJQuery);
		searchInput.addEventListener("input", () => renderCars(loadedCars));
		sortSelect.addEventListener("change", () => renderCars(loadedCars));
		document.getElementById("resetButton").addEventListener("click", () => {
			searchInput.value = "";
			sortSelect.value = "year";
			clearTable("Table cleared. Choose a loading method to load the cars.");
		});
		clearTable("Table empty. Choose fetch() or $.getJSON() to load the cars.");
	</script>
</body>
</html>
