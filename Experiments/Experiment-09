<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Apex &amp; Alloy | Car Accessories</title>
	<style>
		:root {
			--page: #f7f3eb;
			--surface: #fffdf8;
			--surface-strong: #f0eadf;
			--ink: #292621;
			--muted: #776f64;
			--line: #ded5c7;
			--accent: #9a5f35;
			--accent-soft: #ead8c6;
			--shadow: 0 18px 45px rgba(74, 54, 35, 0.10);
		}

		body.dark {
			--page: #292723;
			--surface: #37332e;
			--surface-strong: #454039;
			--ink: #f8f3e9;
			--muted: #c7bdae;
			--line: #5b534a;
			--accent: #e3a878;
			--accent-soft: #614a38;
			--shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
		}

		* { box-sizing: border-box; }
		body {
			margin: 0;
			color: var(--ink);
			background: var(--page);
			font-family: Georgia, "Times New Roman", serif;
			transition: background 180ms ease, color 180ms ease;
		}

		.page-shell { min-height: 100vh; padding: 24px 6vw 48px; }
		header {
			max-width: 1180px;
			margin: 0 auto 62px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
		}
		.brand { display: flex; align-items: center; gap: 12px; }
		.brand-mark {
			width: 42px; height: 42px; display: grid; place-items: center;
			color: var(--surface); background: var(--accent); border-radius: 50%;
			font-size: 20px; font-weight: bold;
		}
		.brand-name { font-size: 1.25rem; letter-spacing: .08em; text-transform: uppercase; }
		.brand-tag { color: var(--muted); font: 11px Arial, sans-serif; letter-spacing: .12em; text-transform: uppercase; }

		.preferences {
			display: flex; align-items: center; gap: 10px; padding: 8px 10px;
			border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
			font: 12px Arial, sans-serif;
		}
		.header-tools { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; margin-left: auto; }
		.student { border: 2px solid var(--accent); padding: 10px 14px; color: var(--ink); background: var(--surface); font: bold 13px Arial, sans-serif; letter-spacing: .06em; text-align: right; }
		.preferences label { color: var(--muted); }
		select {
			color: var(--ink); background: var(--surface-strong); border: 1px solid var(--line);
			border-radius: 5px; padding: 7px 8px; font: inherit; cursor: pointer;
		}

		.hero { max-width: 1180px; margin: 0 auto 62px; display: grid; grid-template-columns: 1.1fr .9fr; gap: 60px; align-items: center; }
		.eyebrow { color: var(--accent); font: bold 11px Arial, sans-serif; letter-spacing: .2em; text-transform: uppercase; }
		h1 { max-width: 650px; margin: 16px 0 20px; font-size: clamp(3rem, 6vw, 5.8rem); line-height: .95; font-weight: normal; letter-spacing: -.04em; }
		.hero-copy { max-width: 490px; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
		.hero-art { min-height: 300px; position: relative; display: grid; place-items: center; }
		.hero-photo { width: min(100%, 460px); aspect-ratio: 4 / 3; object-fit: cover; object-position: center; border: 10px solid var(--surface); box-shadow: var(--shadow); transform: rotate(2deg); }
		.hero-photo-frame { position: absolute; width: min(100%, 460px); aspect-ratio: 4 / 3; border: 1px solid var(--line); transform: rotate(-4deg); }

		.catalogue { max-width: 1180px; margin: 0 auto; }
		.section-heading { display: flex; justify-content: space-between; align-items: end; border-bottom: 1px solid var(--line); padding-bottom: 14px; margin-bottom: 22px; }
		h2 { margin: 0; font-size: 1.8rem; font-weight: normal; }
		.count { color: var(--muted); font: 12px Arial, sans-serif; }
		.products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
		.product { background: var(--surface); border: 1px solid var(--line); padding: 14px; box-shadow: var(--shadow); transition: transform 180ms ease; }
		.product:hover { transform: translateY(-4px); }
		.product-image { height: 170px; display: grid; place-items: center; background: var(--surface-strong); color: var(--accent); font-size: 4rem; }
		.product:nth-child(2) .product-image { color: var(--ink); }
		.product:nth-child(3) .product-image { color: var(--accent); }
		.product h3 { margin: 17px 0 6px; font-size: 1.2rem; font-weight: normal; }
		.product p { min-height: 42px; margin: 0 0 15px; color: var(--muted); font: 13px/1.5 Arial, sans-serif; }
		.product-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-top: 13px; }
		.price { font-size: 1.1rem; }
		.add { border: 1px solid var(--accent); color: var(--accent); background: transparent; padding: 8px 12px; border-radius: 5px; font: 11px Arial, sans-serif; text-transform: uppercase; letter-spacing: .08em; cursor: pointer; }
		.add:hover { color: var(--surface); background: var(--accent); }
		@media (max-width: 760px) {
			.page-shell { padding: 18px 5vw 34px; }
			header { align-items: flex-start; flex-direction: column; margin-bottom: 44px; }
			.header-tools { width: 100%; align-items: stretch; }
			.student { align-self: flex-end; }
			.preferences { width: 100%; justify-content: space-between; }
			.hero { grid-template-columns: 1fr; gap: 10px; margin-bottom: 46px; }
			h1 { font-size: clamp(3.1rem, 16vw, 5rem); }
			.hero-art { min-height: 230px; }
			.products { grid-template-columns: 1fr; }
			.product-image { height: 145px; }
		}
	</style>
</head>
<body>
	<main class="page-shell">
		<header>
			<div class="brand">
				<div class="brand-mark">A</div>
				<div><div class="brand-name">Apex &amp; Alloy</div><div class="brand-tag">Refined car accessories</div></div>
			</div>
			<div class="header-tools">
				<div class="preferences" aria-label="Theme and storage preferences">
					<label for="theme-select">Theme</label>
					<select id="theme-select">
						<option value="light">Light</option>
						<option value="dark">Dark</option>
					</select>
					<label for="storage-select">Save in</label>
					<select id="storage-select">
						<option value="local">Local storage</option>
						<option value="session">Session storage</option>
					</select>
				</div>
				<div class="student">ARPEET PATEL &nbsp;|&nbsp; PRN: 24070521218</div>
			</div>
		</header>

		<section class="hero">
			<div>
				<div class="eyebrow">Curated for the drive</div>
				<h1>Make your car feel like yours.</h1>
				<p class="hero-copy">Thoughtful upgrades for the details you touch, see, and live with every day. Quiet design, considered materials, unmistakably personal.</p>
			</div>
			<div class="hero-art">
				<div class="hero-photo-frame"></div>
				<img class="hero-photo" src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Silver sports car on a winding road">
			</div>
		</section>

		<section class="catalogue">
			<div class="section-heading"><h2>Small upgrades, big character.</h2><span class="count">03 essentials</span></div>
			<div class="products">
				<article class="product"><div class="product-image">◒</div><h3>Contour Floor Mats</h3><p>Weather-ready, tailored protection with a clean edge.</p><div class="product-footer"><span class="price">$84</span><button class="add" type="button">Add to ride</button></div></article>
				<article class="product"><div class="product-image">◉</div><h3>Halo Cabin Lights</h3><p>A warm, adjustable glow for after-dark arrivals.</p><div class="product-footer"><span class="price">$42</span><button class="add" type="button">Add to ride</button></div></article>
				<article class="product"><div class="product-image">⌁</div><h3>Arc Phone Mount</h3><p>Steady navigation in a low-profile aluminum frame.</p><div class="product-footer"><span class="price">$36</span><button class="add" type="button">Add to ride</button></div></article>
			</div>
		</section>

	</main>

	<script>
		(function () {
			var themeSelect = document.getElementById('theme-select');
			var storageSelect = document.getElementById('storage-select');
			var storageKey = 'modhaus-preferences';

			function getStorage(type) {
				return type === 'session' ? window.sessionStorage : window.localStorage;
			}

			function readPreferences(type) {
				try {
					var saved = getStorage(type).getItem(storageKey);
					return saved ? JSON.parse(saved) : null;
				} catch (error) {
					return null;
				}
			}

			function savePreferences() {
				var preferences = { theme: themeSelect.value, storage: storageSelect.value };
				try {
					getStorage(storageSelect.value).setItem(storageKey, JSON.stringify(preferences));
				} catch (error) {
					// Storage may be unavailable in a restricted browser context.
				}
				applyTheme(preferences.theme);
			}

			function applyTheme(theme) {
				document.body.classList.toggle('dark', theme === 'dark');
			}

			function loadPreferences() {
				var localPreferences = readPreferences('local');
				var sessionPreferences = readPreferences('session');
				var saved = sessionPreferences || localPreferences;
				if (saved) {
					themeSelect.value = saved.theme === 'dark' ? 'dark' : 'light';
					storageSelect.value = saved.storage === 'session' ? 'session' : 'local';
				}
				applyTheme(themeSelect.value);
			}

			themeSelect.addEventListener('change', savePreferences);
			storageSelect.addEventListener('change', savePreferences);
			loadPreferences();
		}());
	</script>
</body>
</html>
