<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Palindrome Verification Engine</title>
    <style>
        /* Classic Corporate Minimalist Design */
        :root {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --btn-primary-bg: #0f172a;
            --btn-primary-hover: #1e293b;
            --btn-secondary-bg: #f1f5f9;
            --btn-secondary-hover: #e2e8f0;
            --btn-secondary-border: #e2e8f0;
            --success-bg: #f0fdf4;
            --success-border: #bbf7d0;
            --success-text: #166534;
            --failure-bg: #fef2f2;
            --failure-border: #fecaca;
            --failure-text: #991b1b;
            --error-bg: #fffbeb;
            --error-border: #fef08a;
            --error-text: #854d0e;
            --accent-color: #6366f1;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        body.dark {
            --bg-primary: #0f1419;
            --bg-secondary: #1a1f28;
            --text-primary: #e0e0e0;
            --text-secondary: #a0aec0;
            --text-muted: #7f8c8d;
            --border-color: #2d3748;
            --btn-primary-bg: #3b82f6;
            --btn-primary-hover: #2563eb;
            --btn-secondary-bg: #2d3748;
            --btn-secondary-hover: #3f4757;
            --btn-secondary-border: #4a5568;
            --success-bg: #1b5e20;
            --success-border: #2e7d32;
            --success-text: #a5d6a7;
            --failure-bg: #5d1f1a;
            --failure-border: #c62828;
            --failure-text: #ffab91;
            --error-bg: #663d00;
            --error-border: #e65100;
            --error-text: #ffe0b2;
            --accent-color: #42a5f5;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            transition: background-color 200ms ease, color 200ms ease;
        }

        .pref-panel {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            box-shadow: var(--shadow);
            max-width: 550px;
            width: 100%;
        }

        .pref-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .pref-select {
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: border-color 150ms ease, opacity 150ms ease;
        }

        .pref-select:hover {
            opacity: 0.8;
        }

        .pref-select:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .card {
            background-color: var(--bg-secondary);
            padding: 40px;
            border-radius: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            max-width: 550px;
            width: 100%;
            position: relative;
            padding-bottom: 60px;
            transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 6px;
            letter-spacing: -0.025em;
        }

        .subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 24px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-group input {
            padding: 14px 16px;
            font-size: 1rem;
            border: 1.5px solid var(--border-color);
            border-radius: 12px;
            outline: none;
            transition: all 0.2s ease;
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            width: 100%;
        }

        .form-group input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .button-group {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            font-size: 0.95rem;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-check {
            background-color: var(--btn-primary-bg);
            color: #ffffff;
        }

        .btn-check:hover {
            background-color: var(--btn-primary-hover);
        }

        .btn-clear {
            background-color: var(--btn-secondary-bg);
            color: var(--text-secondary);
            border: 1px solid var(--btn-secondary-border);
        }

        .btn-clear:hover {
            background-color: var(--btn-secondary-hover);
        }

        /* Dynamic Result Area Styles */
        .result-box {
            padding: 16px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            display: none;
            margin-bottom: 10px;
            border: 1px solid transparent;
        }

        .result-box.success {
            display: block;
            background-color: var(--success-bg);
            border-color: var(--success-border);
            color: var(--success-text);
        }

        .result-box.failure {
            display: block;
            background-color: var(--failure-bg);
            border-color: var(--failure-border);
            color: var(--failure-text);
        }

        .result-box.error {
            display: block;
            background-color: var(--error-bg);
            border-color: var(--error-border);
            color: var(--error-text);
        }

        .details {
            font-size: 0.8rem;
            font-weight: 400;
            color: var(--text-secondary);
            margin-top: 6px;
            font-family: monospace;
        }

        /* Strict Bottom-Right Absolute Alignment Boundary */
        .signature-tag {
            position: absolute;
            bottom: 20px;
            right: 40px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            background-color: var(--bg-primary);
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            text-align: right;
            transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
        }

        .signature-tag span {
            color: var(--accent-color);
            font-weight: 700;
        }

        @media (max-width: 500px) {
            .card { padding: 24px; padding-bottom: 70px; }
            .button-group { flex-direction: column; }
            .signature-tag { right: 24px; left: 24px; text-align: center; }
        }
    </style>
</head>
<body>

    <div class="pref-panel">
        <label class="pref-label" for="theme-select">Theme:</label>
        <select class="pref-select" id="theme-select">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
        </select>
        
        <label class="pref-label" for="storage-select">Save in:</label>
        <select class="pref-select" id="storage-select">
            <option value="local">Local Storage</option>
            <option value="session">Session Storage</option>
        </select>
    </div>

    <div class="card">
        <h2>Symmetry Analysis Engine</h2>
        <div class="subtitle">Enter any text phrase, word, or number sequence below.</div>

        <!-- Input Processing Layer -->
        <div class="form-group">
            <label for="sequenceInput">Target Value Input</label>
            <input type="text" id="sequenceInput" placeholder="e.g., Radar, 12321, or Madam" autocomplete="off">
        </div>

        <div class="button-group">
            <button class="btn btn-check" onclick="evaluateSymmetry()">Analyze</button>
            <button class="btn btn-clear" onclick="clearDisplay()">Reset</button>
        </div>

        <!-- System Output Notification Display -->
        <div id="outputDisplay" class="result-box"></div>

        <!-- Target Identification Signature: Anchored Right Bottom -->
        <div class="signature-tag">
            <span>Arpeet Patel</span> ; PRN: 24070521218
        </div>
    </div>

    <script>
        function evaluateSymmetry() {
            const userInput = document.getElementById('sequenceInput').value;
            const outputDisplay = document.getElementById('outputDisplay');

            // 1. Guard check for completely empty field string space properties
            if (!userInput.trim()) {
                outputDisplay.className = "result-box error";
                outputDisplay.innerHTML = "Processing Error: Input parameter cannot be left empty.";
                return;
            }

            // 2. Normalization Engine: Clears spaces, symbols, and switches everything to uniform lower-case
            const normalizedString = userInput.toLowerCase().replace(/[^a-z0-9]/g, '');

            // 3. Fallback boundary evaluation checking if filtering removed all characters
            if (normalizedString.length === 0) {
                outputDisplay.className = "result-box error";
                outputDisplay.innerHTML = "Processing Error: No readable numbers or letters found.";
                return;
            }

            // 4. Inversion Array Logic
            const reversedString = normalizedString.split('').reverse().join('');
            const matchingResult = (normalizedString === reversedString);

            // 5. Interface Mutation Processing Mapping
            if (matchingResult) {
                outputDisplay.className = "result-box success";
                outputDisplay.innerHTML = `
                    ✓ SUCCESS: Valid Palindrome Match
                    <div class="details">Cleaned Sequence: "${normalizedString}" matches inverted state perfectly.</div>
                `;
            } else {
                outputDisplay.className = "result-box failure";
                outputDisplay.innerHTML = `
                    ✗ FAILED: Structural Symmetry Mismatch
                    <div class="details">Cleaned: "${normalizedString}" vs Reversed: "${reversedString}"</div>
                `;
            }
        }

        // Framework UI clearance control
        function clearDisplay() {
            document.getElementById('sequenceInput').value = '';
            document.getElementById('outputDisplay').style.display = "none";
        }

        // Theme and storage preferences
        (function(){
            'use strict';

            var themeSelect = document.getElementById('theme-select');
            var storageSelect = document.getElementById('storage-select');
            var storageKey = 'palindrome-engine-preferences';

            function getStorage(type){
                return type === 'session' ? window.sessionStorage : window.localStorage;
            }

            function readPreferences(type){
                try{
                    var saved = getStorage(type).getItem(storageKey);
                    return saved ? JSON.parse(saved) : null;
                } catch(e){
                    return null;
                }
            }

            function savePreferences(){
                var preferences = {
                    theme: themeSelect.value,
                    storage: storageSelect.value
                };
                try{
                    getStorage(storageSelect.value).setItem(storageKey, JSON.stringify(preferences));
                } catch(e){
                    console.log('Storage unavailable');
                }
                applyTheme(preferences.theme);
            }

            function applyTheme(theme){
                if(theme === 'dark'){
                    document.body.classList.add('dark');
                } else{
                    document.body.classList.remove('dark');
                }
            }

            function loadPreferences(){
                var sessionPreferences = readPreferences('session');
                var localPreferences = readPreferences('local');
                var saved = sessionPreferences || localPreferences;

                if(saved){
                    themeSelect.value = saved.theme === 'dark' ? 'dark' : 'light';
                    storageSelect.value = saved.storage === 'session' ? 'session' : 'local';
                }

                applyTheme(themeSelect.value);
            }

            themeSelect.addEventListener('change', savePreferences);
            storageSelect.addEventListener('change', savePreferences);

            loadPreferences();
        })();
    </script>

</body>
</html>