<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart Total Calculator with Discount Logic</title>
    <link rel="stylesheet" href="style.css">
    <style>
        :root {
            --bg-primary: #eef2f3;
            --bg-secondary: #ffffff;
            --text-primary: #1a1c1e;
            --text-secondary: #6b7280;
            --border-color: #e5e7eb;
            --item-bg: #f8fafc;
            --success-bg: #f0fdf4;
            --success-border: #bbf7d0;
            --success-text: #15803d;
            --error-text: #dc2626;
            --accent-btn: #28a745;
            --accent-btn-hover: #1f7a34;
            --shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        body.dark {
            --bg-primary: #0f1419;
            --bg-secondary: #1a1f28;
            --text-primary: #e0e0e0;
            --text-secondary: #a0aec0;
            --border-color: #2d3748;
            --item-bg: #2d3748;
            --success-bg: #1b5e20;
            --success-border: #2e7d32;
            --success-text: #a5d6a7;
            --error-text: #ff6b6b;
            --accent-btn: #42a5f5;
            --accent-btn-hover: #2196f3;
            --shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Cart page specific styles */
        .cart-page {
            background-color: var(--bg-primary);
            transition: background-color 200ms ease, color 200ms ease;
        }

        .pref-panel {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 18px;
            margin: 20px auto;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            box-shadow: var(--shadow);
            max-width: 520px;
            width: 95%;
        }

        .pref-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .pref-select {
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            font-size: 0.85rem;
            cursor: pointer;
            transition: border-color 150ms ease, opacity 150ms ease;
        }

        .pref-select:hover {
            opacity: 0.8;
        }

        .pref-select:focus {
            outline: none;
            border-color: var(--accent-btn);
            box-shadow: 0 0 0 3px rgba(66, 165, 245, 0.1);
        }

        .cart-container {
            background-color: var(--bg-secondary);
            width: 520px;
            max-width: 95%;
            padding: 25px;
            border-radius: 12px;
            box-shadow: var(--shadow);
            text-align: center;
            transition: background-color 200ms ease, box-shadow 200ms ease;
        }

        .cart-container h1 {
            color: var(--text-primary);
            font-size: 24px;
            margin-bottom: 5px;
        }

        .cart-container .subtitle {
            color: var(--text-secondary);
            font-size: 13px;
            margin-bottom: 20px;
        }

        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
            text-align: left;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--item-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 15px;
            transition: background-color 200ms ease, border-color 200ms ease;
        }

        .cart-item .item-info {
            display: flex;
            flex-direction: column;
        }

        .cart-item .item-name {
            font-weight: bold;
            color: var(--text-primary);
        }

        .cart-item .item-meta {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .cart-item .item-total {
            font-weight: bold;
            color: var(--accent-btn);
        }

        .summary {
            background-color: var(--success-bg);
            border: 1px solid var(--success-border);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            text-align: left;
            transition: background-color 200ms ease, border-color 200ms ease;
        }

        .summary .row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 14px;
            color: var(--text-primary);
        }

        .summary .row.discount {
            color: var(--error-text);
            font-weight: bold;
        }

        .summary .row.total {
            font-size: 18px;
            font-weight: bold;
            color: var(--text-primary);
            border-top: 1px solid var(--success-border);
            margin-top: 6px;
            padding-top: 8px;
        }

        .controls {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .controls input {
            flex: 1;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
        }

        .controls button {
            background-color: var(--accent-btn);
            color: #fff;
            border: none;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            height: auto;
            width: auto;
            transition: background-color 150ms ease;
        }

        .controls button:hover {
            background-color: var(--accent-btn-hover);
        }

        .promo-message {
            min-height: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 10px;
            color: var(--text-secondary);
        }

        .promo-message.valid {
            color: var(--success-text);
        }

        .promo-message.invalid {
            color: var(--error-text);
        }

        /* Bottom-right credit footer */
        .credit-footer {
            position: fixed;
            bottom: 12px;
            right: 16px;
            font-size: 13px;
            color: var(--text-primary);
            background-color: var(--bg-secondary);
            padding: 6px 12px;
            border-radius: 6px;
            box-shadow: var(--shadow);
            font-weight: bold;
            z-index: 100;
            transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
        }
    </style>
</head>
<body class="cart-page">

    <div class="pref-panel">
        <label class="pref-label" for="theme-select">Theme:</label>
        <select class="pref-select" id="theme-select">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
        </select>
        
        <label class="pref-label" for="storage-select">Save in:</label>
        <select class="pref-select" id="storage-select">
            <option value="local">Local Storage</option>
            <option value="session">Session Storage</option>
        </select>
    </div>

    <div class="cart-container">
        <h1>🛒 Cart Total Calculator</h1>
        <p class="subtitle">Built with Array Methods &amp; Object Handling</p>

        <div class="cart-items" id="cartItems"></div>

        <div class="summary" id="summary">
            <div class="row"><span>Subtotal</span><span id="subtotal">₹0.00</span></div>
            <div class="row discount"><span>Discount</span><span id="discount">-₹0.00</span></div>
            <div class="row total"><span>Final Total</span><span id="grandTotal">₹0.00</span></div>
        </div>

        <div class="controls">
            <input type="text" id="promoInput" placeholder="Enter promo code (SAVE10)">
            <button onclick="applyPromo()">Apply</button>
        </div>
        <div class="promo-message" id="promoMsg"></div>
        <button onclick="resetCart()" style="background-color:#dc2626; color:#fff; border:none; padding:10px 18px; border-radius:6px; cursor:pointer; font-weight:bold;">Reset / Clear Promo</button>
    </div>

    <!-- Credit Footer at bottom-right -->
    <div class="credit-footer">Arpeet Patel &nbsp;|&nbsp; PRN: 24070521218</div>

    <script>
        // ============================================================
        // OBJECT HANDLING: Cart stored as an array of product objects
        // ============================================================
        const cart = [
            { id: 1, name: "Wireless Mouse",   price: 499,   quantity: 2, category: "electronics" },
            { id: 2, name: "Mechanical Keyboard", price: 1299, quantity: 1, category: "electronics" },
            { id: 3, name: "USB-C Cable",      price: 199,   quantity: 3, category: "accessories" },
            { id: 4, name: "Laptop Stand",     price: 899,   quantity: 1, category: "accessories" },
            { id: 5, name: "Desk Lamp",        price: 749,   quantity: 1, category: "home" }
        ];

        // Promo code configurations (object handling)
        const promoCodes = {
            SAVE10: 0.10, // 10% off on subtotal
            SAVE20: 0.20  // 20% off on subtotal
        };

        let appliedPromo = "";
        let promoValid = false;

        // ============================================================
        // ARRAY METHODS + OBJECT HANDLING
        // ============================================================

        // 1. map() + object dot access: compute each item's line total
        function getLineTotals() {
            return cart.map(item => ({
                ...item,
                lineTotal: item.price * item.quantity
            }));
        }

        // 2. reduce(): compute the subtotal from all line totals
        function getSubtotal(itemsWithTotals) {
            return itemsWithTotals.reduce(
                (sum, item) => sum + item.lineTotal,
                0
            );
        }

        // 3. filter(): get items eligible for a category-based discount
        function getCategoryDiscount(itemsWithTotals) {
            // 5% extra off on all 'electronics' items (object property handling)
            const electronics = itemsWithTotals.filter(item => item.category === "electronics");
            const electronicsValue = electronics.reduce(
                (sum, item) => sum + item.lineTotal,
                0
            );
            return electronicsValue * 0.05;
        }

        // 4. Object.keys() + Object.values(): work with promo code object
        function applyPromo() {
            const input = document.getElementById("promoInput").value.trim().toUpperCase();
            const promoMsg = document.getElementById("promoMsg");

            if (promoCodes.hasOwnProperty(input)) {
                appliedPromo = input;
                promoValid = true;
                promoMsg.className = "promo-message valid";
                promoMsg.innerText = `Promo '${input}' applied! You get ${promoCodes[input] * 100}% off.`;
            } else {
                appliedPromo = "";
                promoValid = false;
                promoMsg.className = "promo-message invalid";
                promoMsg.innerText = "Invalid promo code. Try SAVE10 or SAVE20.";
            }
            renderCart();
        }

        // Reset cart quantities back and clear promo
        function resetCart() {
            cart.forEach((item, index) => {
                cart[index].quantity = [2, 1, 3, 1, 1][index];
            });
            appliedPromo = "";
            promoValid = false;
            document.getElementById("promoInput").value = "";
            document.getElementById("promoMsg").className = "promo-message";
            document.getElementById("promoMsg").innerText = "";
            renderCart();
        }

        // ============================================================
        // RENDER: Build the UI
        // ============================================================
        function renderCart() {
            const itemsWithTotals = getLineTotals();
            const subtotal = getSubtotal(itemsWithTotals);

            // Category-based discount (always applied)
            const categoryDiscount = getCategoryDiscount(itemsWithTotals);

            // Promo-code discount (if valid)
            const promoRate = promoValid ? promoCodes[appliedPromo] : 0;
            const promoDiscount = subtotal * promoRate;

            // Total discount = category discount + promo discount
            const totalDiscount = categoryDiscount + promoDiscount;
            const grandTotal = subtotal - totalDiscount;

            // Render each cart item using map() + object destructuring
            const cartItemsDiv = document.getElementById("cartItems");
            cartItemsDiv.innerHTML = itemsWithTotals.map(({ name, price, quantity, lineTotal, category }) => `
                <div class="cart-item">
                    <span class="item-info">
                        <span class="item-name">${name} <span style="font-size:11px;color:#9ca3af;">(${category})</span></span>
                        <span class="item-meta">₹${price} × ${quantity}</span>
                    </span>
                    <span class="item-total">₹${lineTotal.toFixed(2)}</span>
                </div>
            `).join("");

            // Update summary (object handling with toFixed for money)
            document.getElementById("subtotal").innerText = `₹${subtotal.toFixed(2)}`;
            document.getElementById("discount").innerText = `-₹${totalDiscount.toFixed(2)}`;
            document.getElementById("grandTotal").innerText = `₹${grandTotal.toFixed(2)}`;
        }

        // Initial render
        renderCart();

        // Theme and storage preferences
        (function(){
            'use strict';

            var themeSelect = document.getElementById('theme-select');
            var storageSelect = document.getElementById('storage-select');
            var storageKey = 'cart-calculator-preferences';

            function getStorage(type){
                return type === 'session' ? window.sessionStorage : window.localStorage;
            }

            function readPreferences(type){
                try{
                    var saved = getStorage(type).getItem(storageKey);
                    return saved ? JSON.parse(saved) : null;
                } catch(e){
                    return null;
                }
            }

            function savePreferences(){
                var preferences = {
                    theme: themeSelect.value,
                    storage: storageSelect.value
                };
                try{
                    getStorage(storageSelect.value).setItem(storageKey, JSON.stringify(preferences));
                } catch(e){
                    console.log('Storage unavailable');
                }
                applyTheme(preferences.theme);
            }

            function applyTheme(theme){
                if(theme === 'dark'){
                    document.body.classList.add('dark');
                } else{
                    document.body.classList.remove('dark');
                }
            }

            function loadPreferences(){
                var sessionPreferences = readPreferences('session');
                var localPreferences = readPreferences('local');
                var saved = sessionPreferences || localPreferences;

                if(saved){
                    themeSelect.value = saved.theme === 'dark' ? 'dark' : 'light';
                    storageSelect.value = saved.storage === 'session' ? 'session' : 'local';
                }

                applyTheme(themeSelect.value);
            }

            themeSelect.addEventListener('change', savePreferences);
            storageSelect.addEventListener('change', savePreferences);

            loadPreferences();
        })();
    </script>
</body>
</html>